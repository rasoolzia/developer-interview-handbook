{
  "name": "developer-interview-handbook",
  "version": "2.1.0",
  "schemaVersion": "4.0.0",
  "description": "Validation and generation tools for interview questions",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "validate:file": "pnpm build && node dist/cli.js file",
    "validate:topic": "pnpm build && node dist/cli.js topic",
    "validate": "pnpm build && node dist/cli.js",
    "generate": "pnpm build && node dist/cli.js generate",
    "generate:strict": "pnpm build && node dist/cli.js generate --strict",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "interview",
    "questions",
    "validator",
    "generator"
  ],
  "author": "RasoolZia",
  "license": "ISC",
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@types/node": "^26.0.1",
    "gray-matter": "^4.0.3",
    "typescript": "^6.0.3"
  }
}
